# Go binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go test binary
*.test

# Coverage (Go + vitest)
*.out
coverage.html
coverage/

# Go build cache
/bin/
/tmp/

# Node.js
node_modules/

# IDE
.idea/
# Share the workspace settings (moon YAML schemas + oxc as formatter); keep
# everything else in .vscode/ local.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# pnpm falls back to a project-local store when no global one is configured
.pnpm-store/

# moon
.moon/cache/
.moon/docker/

# TypeScript project references emit declarations into a gitignored dist/
*.tsbuildinfo
dist/
**/dist/
# ...but not the wails embed dir itself — see the note further down. The
# directory must stay un-ignored for the negation below to be reachable.
!apps/desktop/frontend/dist/

# pnpm-only
package-lock.json
yarn.lock

# Wails: build outputs and per-machine artefacts.
# NOTE: apps/desktop/frontend/bindings/ is deliberately NOT ignored — the
# generated bindings are committed, and the frontend build fails without them.
.task
bin/
# The `//go:embed all:frontend/dist` directive in main.go fails to COMPILE if
# the directory does not exist, which would break `go build`, golangci-lint and
# `go test` on a fresh clone. Track an empty placeholder so every Go tool works
# before the frontend has ever been bundled; ignore the real build output.
apps/desktop/frontend/dist/*
!apps/desktop/frontend/dist/.gitkeep
# Generated by `moon run desktop:package`. The script cleans these up on a
# successful run; these entries stop a FAILED run from leaving a ~10MB binary
# copy staged for the next commit.
apps/desktop/build/linux/appimage/build/
apps/desktop/build/linux/appimage/desktop
apps/desktop/build/linux/appimage/*.png
apps/desktop/build/linux/desktop
apps/desktop/build/linux/*.desktop
apps/desktop/build/windows/nsis/MicrosoftEdgeWebview2Setup.exe
# Mobile targets are out of scope for this template, but
# `moon run desktop:update-build-assets` regenerates their scaffolding.
apps/desktop/build/ios/
apps/desktop/build/android/
*.syso

# Local env. `.env.example` is committed as the template; real values are not.
.env
.env.*
!.env.example
