# Copy to `.env` and edit. `.env` is gitignored; this file is committed.
#
# This is the Vite env root (vite.config.ts sets no `envDir`), so this is the
# one place a `.env` is actually loaded from in this repo.

# The window/page title. Validated in src/env.ts, which supplies this same
# default if the variable is absent — so a missing .env is a working app, not
# a broken one.
VITE_APP_TITLE="Wails + React"

# ---------------------------------------------------------------------------
# NOT read from this file — listed so nobody goes looking for them here.
#
# Vite only exposes VITE_-prefixed values, and only to the bundle; it does not
# populate process.env, and Go loads no .env at all (there is no godotenv
# dependency). These are SHELL-exported, and the dev script exports them for
# you:
#
#   WAILS_TRACE=1           opt-in Go execution trace -> trace.out.
#                           Read by os.Getenv in apps/desktop/main.go.
#                           Usage: WAILS_TRACE=1 ./apps/desktop/bin/desktop
#
#   WAILS_VITE_PORT         port vite must bind, strictPort (default 9245).
#                           Read by vite.config.ts from the real process env.
#   FRONTEND_DEVSERVER_URL  told to the Go side so a non-production build
#                           proxies assets to vite instead of the embedded FS.
#
# Both of the latter are exported by scripts/wails-dev.sh. Changing one without
# the other breaks dev mode — see .claude/rules/wails/build-and-dev.md.
